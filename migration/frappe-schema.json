        {"fieldname": "rol", "fieldtype": "Data", "label": "Rol", "_note": "Cirujano, asesor, asistente, etc."}
      ]
    },
    "Cirugia Previa Item": {
      "istable": 1,
      "module": "Custom",
      "_purpose": "Child de Contact + CRM Deal. Catálogo de cirugías previas multi-select.",
      "fields": [
        {"fieldname": "cirugia", "fieldtype": "Data", "label": "Cirugía", "in_list_view": 1, "reqd": 1},
        {"fieldname": "fecha", "fieldtype": "Date", "label": "Fecha (aproximada)"},
        {"fieldname": "observacion", "fieldtype": "Small Text", "label": "Observación"}
      ]
    }
  },

  "server_scripts": [
    {
      "name": "rut_normalizado_contact",
      "doctype_event": "Contact",
      "trigger": "before_save",
      "description": "Calcular rut_normalizado desde rut (algoritmo Chile módulo 11)",
      "code": "import re\nif doc.rut:\n    raw = re.sub(r'[^0-9Kk]', '', str(doc.rut)).upper()\n    if len(raw) >= 2:\n        doc.rut_normalizado = raw"
    },
    {
      "name": "rut_normalizado_deal",
      "doctype_event": "CRM Deal",
      "trigger": "before_save",
      "description": "Idem para CRM Deal (campos canonical iguales)",
      "code": "import re\nif doc.rut:\n    raw = re.sub(r'[^0-9Kk]', '', str(doc.rut)).upper()\n    if len(raw) >= 2:\n        doc.rut_normalizado = raw"
    },
    {
      "name": "imc_calc_contact",
      "doctype_event": "Contact",
      "trigger": "before_save",
      "description": "Calcular IMC desde peso_kg y estatura_m",
      "code": "if doc.peso_kg and doc.estatura_m and float(doc.estatura_m) > 0:\n    doc.imc = round(float(doc.peso_kg) / (float(doc.estatura_m) ** 2), 2)"
    },
    {
      "name": "imc_calc_deal",
      "doctype_event": "CRM Deal",
      "trigger": "before_save",
      "description": "Idem para Deal",
      "code": "if doc.peso_kg and doc.estatura_m and float(doc.estatura_m) > 0:\n    doc.imc = round(float(doc.peso_kg) / (float(doc.estatura_m) ** 2), 2)"
    },
    {
      "name": "diff_dias_deal",
      "doctype_event": "CRM Deal",
      "trigger": "before_save",
      "description": "Calcular diff_cirugia_hito2 (días entre fecha_cirugia y fecha_hito_2)",
      "code": "from frappe.utils import date_diff\nif doc.fecha_cirugia and doc.fecha_hito_2:\n    doc.diff_cirugia_hito2 = date_diff(doc.fecha_cirugia, doc.fecha_hito_2)"
    },
    {
      "name": "whatsapp_link_deal",
      "doctype_event": "CRM Deal",
      "trigger": "before_save",
      "description": "Generar wa.me/{digits} desde phone (mantiene compatibilidad con ZAP update-comisiones)",
      "code": "import re\nif doc.phone:\n    digits = re.sub(r'\\D', '', str(doc.phone))\n    if digits:\n        doc.whatsapp_contactar_link = f'https://wa.me/{digits}'"
    }
  ],

  "_apply_order": [
    "1. delete_defaults: lead_sources, lead_statuses, deal_statuses",
    "2. create child_doctypes: Cirugia Previa Item, Clinyco Comision, Clinyco Colaborador",
    "3. create custom_fields on CRM Lead Source (is_for_lead, is_for_deal)",
    "4. create lead_sources items (con is_for_lead/is_for_deal flags)",
    "5. create lead_statuses items",
    "6. create deal_statuses items",
    "7. create custom_fields on Contact (orden importante: Tabla MultiSelect después que child doctype exista)",
    "8. create custom_fields on CRM Lead",
    "9. create custom_fields on CRM Deal (incluye fetch_from a Contact, requiere que Contact ya tenga los fields)",
    "10. create server_scripts (apply los 6)",
    "11. validate: hacer un Lead/Deal/Contact de prueba con todos los campos"
  ]
}
